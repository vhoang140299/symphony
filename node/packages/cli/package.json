{
  "name": "@ai-symphony/node",
  "version": "0.6.0",
  "description": "TypeScript implementation of the Symphony coding-agent orchestrator",
  "keywords": [
    "ai",
    "automation",
    "coding-agent",
    "orchestrator"
  ],
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "symphony-node": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@ai-symphony/agents": "workspace:*",
    "@ai-symphony/core": "workspace:*",
    "@ai-symphony/server": "workspace:*",
    "@ai-symphony/trackers": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "0.3.226",
    "@openai/codex": "0.147.0",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
