{
  "name": "@ai-symphony/monorepo",
  "version": "0.6.0",
  "description": "Monorepo for the TypeScript implementation of the Symphony coding-agent orchestrator",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @ai-symphony/dashboard run build",
    "check": "tsc -b && tsc -p tsconfig.test.json && pnpm --filter @ai-symphony/dashboard run check",
    "clean": "tsc -b --clean && rm -rf packages/*/dist",
    "start": "node packages/cli/dist/cli.js",
    "test": "pnpm run build && vitest run",
    "test:integration:github": "vitest run --reporter=verbose packages/trackers/test/github-live.test.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
